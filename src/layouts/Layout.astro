---
import '@/styles/global.css'

import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import type { Lang } from '@/i18n/ui'
import { PUBLICATIONS } from '@/data/publications'
import { HUB, PERSON_ID, PROFILES, WEBSITE_ID, abs } from '@/lib/site'

interface Props {
  title: string
  description: string
  lang?: Lang
  noindex?: boolean
}

const { title, description, lang = 'en', noindex = false } = Astro.props

const canonicalURL = abs(Astro.url.pathname)
// Social card (1200×630) for link previews; the clean portrait stays the
// structured-data image.
const ogImage = abs('/og-image.jpg')
const portrait = abs('/landingImage.jpg')
const ogImageAlt = 'Eduard Ferré — AI / Data Engineer. LLMs, GraphRAG, Knowledge Graphs'

// hreflang alternates (the portfolio is published in en at / and es at /es/)
const alternates = [
  { hreflang: 'en', href: abs('/') },
  { hreflang: 'es', href: abs('/es/') },
  { hreflang: 'x-default', href: abs('/') }
]

const upc = {
  '@type': 'CollegeOrUniversity',
  name: 'Universitat Politècnica de Catalunya (UPC)',
  url: 'https://www.upc.edu'
}
const uc3m = {
  '@type': 'CollegeOrUniversity',
  name: 'Universidad Carlos III de Madrid (UC3M)',
  url: 'https://www.uc3m.es'
}

// Shared nodes (#person, #website) are byte-identical in both languages and
// written in the default language; only the ProfilePage node varies per page.
const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'Eduard Ferré',
  alternateName: 'Edu Ferré',
  url: `${HUB}/`,
  mainEntityOfPage: abs('/'),
  image: portrait,
  jobTitle: 'AI / Data Engineer',
  description:
    'AI / Data Engineer at Carver Advanced Systems, building LLM, GraphRAG and Knowledge Graph platforms and AI-driven Mainframe (COBOL/JCL) code analysis for the financial sector.',
  worksFor: {
    '@type': 'Organization',
    name: 'Carver Advanced Systems',
    url: 'https://carver-as.com'
  },
  homeLocation: {
    '@type': 'Place',
    address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' }
  },
  alumniOf: [upc, uc3m],
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: "Bachelor's degree in Aerospace Systems Engineering",
      recognizedBy: upc
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: "Bachelor's degree in Telematics Engineering",
      recognizedBy: upc
    },
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'degree',
      name: "Master's degree in Big Data Analytics",
      recognizedBy: uc3m
    }
  ],
  knowsAbout: [
    'Artificial Intelligence',
    'Large Language Models',
    'Retrieval-Augmented Generation',
    'GraphRAG',
    'Knowledge Graphs',
    'Neo4j',
    'Multi-agent systems',
    'Data lineage',
    'COBOL',
    'JCL',
    'Mainframe modernization',
    'Data Engineering',
    'Python',
    'eSIM',
    'Software Engineering'
  ],
  knowsLanguage: ['es', 'ca', 'en'],
  sameAs: [PROFILES.github, PROFILES.linkedin, PROFILES.orcid, PROFILES.scholar]
}

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  url: abs('/'),
  name: 'Eduard Ferré — Portfolio',
  inLanguage: ['en', 'es'],
  publisher: { '@id': PERSON_ID }
}

const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${canonicalURL}#profilepage`,
  url: canonicalURL,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': WEBSITE_ID },
  mainEntity: { '@id': PERSON_ID },
  dateModified: new Date().toISOString().slice(0, 10)
}

// Peer-reviewed work, authored by #person — the strongest expertise signal here.
const articles = PUBLICATIONS.map((p) => ({
  '@type': 'ScholarlyArticle',
  '@id': `https://doi.org/${p.doi}`,
  headline: p.title,
  url: p.href,
  sameAs: `https://doi.org/${p.doi}`,
  identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.doi },
  datePublished: p.year,
  isPartOf: { '@type': 'Periodical', name: p.venue },
  author: { '@id': PERSON_ID }
}))

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, profilePage, ...articles]
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- Apply theme before first paint (no FOUC, independent of page-load timing) -->
    <script is:inline src="/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Eduard Ferré" />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="theme-color" content="#07070A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F7F6F2" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <!-- Identity: same person as these profiles (IndieAuth / rel=me) -->
    <link rel="me" href={PROFILES.github} />
    <link rel="me" href={PROFILES.linkedin} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content="Eduard" />
    <meta property="profile:last_name" content="Ferré" />
    <meta property="og:site_name" content="Eduard Ferré" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Preload LCP image -->
    <link rel="preload" as="image" href="/landingImage.jpg" fetchpriority="high" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <ClientRouter />
  </head>
  <body class="relative text-fg">
    <!-- Atmospheric background: dotted grid + vignette + colour auras.
         Same treatment as the eduardferre.dev hub. -->
    <div class="dot-grid fixed inset-0 z-[-3] pointer-events-none" aria-hidden="true"></div>
    <div class="vignette fixed inset-0 z-[-2] pointer-events-none" aria-hidden="true"></div>
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none" aria-hidden="true">
      <div
        class="absolute -top-32 -left-16 w-[520px] h-[520px] rounded-full bg-violet-500/[0.09] dark:bg-violet-500/[0.10] blur-[110px]"
      >
      </div>
      <div
        class="absolute top-[38%] left-[42%] w-[420px] h-[420px] rounded-full bg-teal-400/[0.07] dark:bg-cyan-400/[0.07] blur-[110px]"
      >
      </div>
      <div
        class="absolute top-8 right-[-4rem] w-[420px] h-[420px] rounded-full bg-fuchsia-400/[0.06] dark:bg-fuchsia-500/[0.07] blur-[110px]"
      >
      </div>
      <div
        class="absolute bottom-0 left-[10%] w-[400px] h-[400px] rounded-full bg-amber-300/[0.07] dark:bg-amber-400/[0.05] blur-[120px]"
      >
      </div>
    </div>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />

  </body>
</html>

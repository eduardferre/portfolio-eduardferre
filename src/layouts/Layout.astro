---
import '@/styles/global.css'

import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import SpeedInsights from '@vercel/speed-insights/astro'
import Analytics from '@vercel/analytics/astro'
import type { Lang } from '@/i18n/ui'

interface Props {
  title: string
  description: string
  lang?: Lang
}

const { title, description, lang = 'en' } = Astro.props

const SITE = 'https://eduardferre.dev'
const canonicalURL = new URL(Astro.url.pathname, SITE).href
const ogImage = new URL('/landingImage.jpg', SITE).href

// hreflang alternates (the portfolio is published in en at / and es at /es/)
const alternates = [
  { hreflang: 'en', href: `${SITE}/` },
  { hreflang: 'es', href: `${SITE}/es/` },
  { hreflang: 'x-default', href: `${SITE}/` }
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Eduard Ferré',
  alternateName: 'Edu Ferré',
  url: `${SITE}/`,
  image: ogImage,
  jobTitle: 'AI / Data Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Carver Advanced Systems',
    url: 'https://carver-as.com'
  },
  address: {
    '@type': 'PostalPlace',
    addressLocality: 'Barcelona',
    addressCountry: 'ES'
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universitat Politècnica de Catalunya (UPC)' },
    { '@type': 'CollegeOrUniversity', name: 'Universidad Carlos III de Madrid (UC3M)' }
  ],
  knowsAbout: [
    'Artificial Intelligence',
    'Large Language Models',
    'Retrieval-Augmented Generation',
    'Knowledge Graphs',
    'Data Engineering',
    'Software Engineering'
  ],
  sameAs: [
    'https://github.com/eduardferre',
    'https://linkedin.com/in/eduardferre'
  ]
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- Apply theme before first paint (no FOUC, independent of page-load timing) -->
    <script is:inline src="/theme-init.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Eduard Ferré" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#07070A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F7F6F2" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eduard Ferré" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preload LCP image -->
    <link rel="preload" as="image" href="/landingImage.jpg" fetchpriority="high" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <ClientRouter />
  </head>
  <body class="relative text-fg">
    <!-- Atmospheric background: dotted grid + vignette + colour auras.
         Same treatment as the eduardferre.dev hub. -->
    <div class="dot-grid fixed inset-0 z-[-3] pointer-events-none" aria-hidden="true"></div>
    <div class="vignette fixed inset-0 z-[-2] pointer-events-none" aria-hidden="true"></div>
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none" aria-hidden="true">
      <div
        class="absolute -top-32 -left-16 w-[520px] h-[520px] rounded-full bg-violet-500/[0.09] dark:bg-violet-500/[0.10] blur-[110px]"
      >
      </div>
      <div
        class="absolute top-[38%] left-[42%] w-[420px] h-[420px] rounded-full bg-teal-400/[0.07] dark:bg-cyan-400/[0.07] blur-[110px]"
      >
      </div>
      <div
        class="absolute top-8 right-[-4rem] w-[420px] h-[420px] rounded-full bg-fuchsia-400/[0.06] dark:bg-fuchsia-500/[0.07] blur-[110px]"
      >
      </div>
      <div
        class="absolute bottom-0 left-[10%] w-[400px] h-[400px] rounded-full bg-amber-300/[0.07] dark:bg-amber-400/[0.05] blur-[120px]"
      >
      </div>
    </div>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />

    <SpeedInsights />
    <Analytics />
  </body>
</html>

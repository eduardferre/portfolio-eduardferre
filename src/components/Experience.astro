---
import ExperienceItem from './ExperienceItem.astro'
import { PUBLICATIONS } from '@/data/publications'
import { ROLES, type Role } from '@/data/roles'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

// Years in the Carver role, so the metric never goes stale.
const CARVER_START = new Date(2025, 7, 1)
const yearsAtCarver = Math.max(
  1,
  Math.floor((Date.now() - CARVER_START.getTime()) / (365.25 * 24 * 3600 * 1000))
)


const role = ({ key, company, link, start, end }: Role) => ({
  startDate: `${t(start[0])} ${start[1]}`,
  endDate: end ? `${t(end[0])} ${end[1]}` : t('date.present'),
  title: t(`experience.${key}.title`),
  description: t(`experience.${key}.description`),
  company,
  link,
  current: end === null
})

const EXPERIENCE = [
  {
    ...role(ROLES[0]),
    // Scale figures of the work — no end-client names (NDA).
    metrics: [
      { value: `${yearsAtCarver}+`, label: t('metric.years') },
      { value: '7', label: t('metric.projects') },
      // Not a real figure — it rolls to a new number on every visit.
      { value: '365', label: t('metric.coffees'), roll: true }
    ],
    technologies: [
      'Python',
      'LLMs',
      'Multi-Agent',
      'RAG',
      'Knowledge Graphs',
      'GraphRAG',
      'Neo4j',
      'ANTLR',
      'Tool calling',
      'OpenAI API',
      'Azure',
      'LiteLLM',
      'COBOL/JCL',
      'Data Engineering'
    ]
  },
  {
    ...role(ROLES[1]),
    technologies: [
      'Java',
      'Spring Boot',
      'Oracle SQL',
      'JavaScript',
      'TypeScript',
      'MongoDB',
      'Angular',
      'Git',
      'SCRUM',
      'API Rest',
      'Jira',
      'Confluence',
      'Bitbucket',
      'Sourcetree',
      'Jenkins',
      'SonarQube'
    ]
  },
  {
    ...role(ROLES[2]),
    technologies: ['Matlab', 'KiCad', 'BenchVue', 'AvaSoft'],
    publications: PUBLICATIONS
  }
]
---

<ol class="flex flex-col gap-y-6 md:gap-y-8">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} lang={lang} />
      </li>
    ))
  }
</ol>

---
import ExperienceItem from './ExperienceItem.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

const today = new Date()
const month = today.toLocaleString(lang === 'es' ? 'es-ES' : 'en-US', {
  month: 'long'
})
const year = today.getFullYear()

const EXPERIENCE = [
  {
    startDate: `${t('date.august')} 2025`,
    endDate: `${month.charAt(0).toUpperCase() + month.slice(1)} ${year}`,
    title: t('experience.0.title'),
    company: 'Carver Advanced Systems',
    description: t('experience.0.description'),
    link: 'https://carver-as.com',
    technologies: [
      'Python',
      'LLMs',
      'Knowledge Graphs',
      'RAG',
      'AI',
      'Mainframe',
      'Data Engineering'
    ]
  },
  {
    startDate: `${t('date.august')} 2023`,
    endDate: `${t('date.august')} 2025`,
    title: t('experience.1.title'),
    company: 'Giesecke+Devrient',
    description: t('experience.1.description'),
    link: 'https://www.gi-de.com/',
    technologies: [
      'Java',
      'SQL',
      'JavaScript',
      'TypeScript',
      'MongoDB',
      'Angular',
      'Git',
      'SCRUM',
      'API Rest',
      'Jira',
      'Confluence',
      'Bitbucket'
    ]
  },
  {
    startDate: `${t('date.february')} 2023`,
    endDate: `${t('date.july')} 2023`,
    title: t('experience.2.title'),
    company: 'Universitat Politécnica de Catalunya',
    description: t('experience.2.description'),
    link: 'https://doi.org/10.3390/proceedings2024097149',
    technologies: ['Matlab', 'KiCad', 'BenchVue', 'AvaSoft']
  }
]
---

<ol class="relative mt-8 md:mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} lang={lang} />
      </li>
    ))
  }
</ol>

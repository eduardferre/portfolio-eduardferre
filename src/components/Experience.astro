---
import ExperienceItem from './ExperienceItem.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

// Years in the Carver role, so the metric never goes stale.
const CARVER_START = new Date(2025, 7, 1)
const yearsAtCarver = Math.max(
  1,
  Math.floor((Date.now() - CARVER_START.getTime()) / (365.25 * 24 * 3600 * 1000))
)


const EXPERIENCE = [
  {
    startDate: `${t('date.august')} 2025`,
    // Ongoing role: never render a concrete end date, which reads as "left".
    endDate: t('date.present'),
    title: t('experience.0.title'),
    company: 'Carver Advanced Systems',
    description: t('experience.0.description'),
    link: 'https://carver-as.com',
    current: true,
    // Scale figures of the work — no end-client names (NDA).
    metrics: [
      { value: `${yearsAtCarver}+`, label: t('metric.years') },
      { value: '7', label: t('metric.projects') },
      // Not a real figure — it rolls to a new number on every visit.
      { value: '365', label: t('metric.coffees'), roll: true }
    ],
    technologies: [
      'Python',
      'LLMs',
      'Multi-Agent',
      'RAG',
      'Knowledge Graphs',
      'Neo4j',
      'OpenAI API',
      'Azure',
      'LiteLLM',
      'COBOL/JCL',
      'Data Engineering'
    ]
  },
  {
    startDate: `${t('date.august')} 2023`,
    endDate: `${t('date.august')} 2025`,
    title: t('experience.1.title'),
    company: 'Giesecke+Devrient',
    description: t('experience.1.description'),
    link: 'https://www.gi-de.com/',
    technologies: [
      'Java',
      'Spring Boot',
      'Oracle SQL',
      'JavaScript',
      'TypeScript',
      'MongoDB',
      'Angular',
      'Git',
      'SCRUM',
      'API Rest',
      'Jira',
      'Confluence',
      'Bitbucket',
      'Sourcetree',
      'Jenkins',
      'SonarQube'
    ]
  },
  {
    startDate: `${t('date.february')} 2023`,
    endDate: `${t('date.july')} 2023`,
    title: t('experience.2.title'),
    company: 'Universitat Politécnica de Catalunya',
    description: t('experience.2.description'),
    technologies: ['Matlab', 'KiCad', 'BenchVue', 'AvaSoft'],
    // Co-authored output of the CELISA project. Titles stay in English (the
    // language they were published in) in both locales.
    publications: [
      {
        title:
          'Low-Area PV Cells Under Indoor Artificial Lighting: A Comparative Study',
        venue: 'IEEE Transactions on Instrumentation and Measurement',
        year: '2025',
        href: 'https://ieeexplore.ieee.org/document/10909273'
      },
      {
        title:
          'Comparative analysis of low-power PV cells of different technologies under different types of indoor artificial lighting',
        venue: 'IEEE I2MTC',
        year: '2024',
        href: 'https://ieeexplore.ieee.org/document/10561134'
      },
      {
        title:
          'Systematic Experimental Evaluation of Submilliwatt PV Cells for Indoor Applications',
        venue: 'Eurosensors / MDPI Proceedings',
        year: '2023',
        href: 'https://www.mdpi.com/2504-3900/97/1/149'
      },
      {
        title: 'FOCV-MPPT Power Management Unit for Submilliwatt Indoor PV Cells',
        venue: 'Eurosensors / MDPI Proceedings',
        year: '2023',
        href: 'https://www.mdpi.com/2504-3900/97/1/99'
      }
    ]
  }
]
---

<ol class="flex flex-col gap-y-6 md:gap-y-8">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} lang={lang} />
      </li>
    ))
  }
</ol>

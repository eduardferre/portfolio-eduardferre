---
import ExperienceItem from './ExperienceItem.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

const today = new Date()
const month = today.toLocaleString(lang === 'es' ? 'es-ES' : 'en-US', {
  month: 'long'
})
const year = today.getFullYear()

const EXPERIENCE = [
  {
    startDate: 'March 2025',
    endDate: `${month} ${year}`,
    title: 'Data Engineer',
    company: 'Carver Advanced Systems',
    description:
      'Leading multiple projects involving Large Language Models (LLMs), Knowledge Graphs with Retrieval-Augmented Generation (RAG), and Mainframe Analysis using AI techniques.',
    link: 'https://carver-as.com',
    technologies: [
      'Python',
      'LLMs',
      'Knowledge Graphs',
      'RAG',
      'AI',
      'Mainframe',
      'Data Engineering'
    ]
  },
  {
    startDate: 'August 2023',
    endDate: 'March 2025',
    title: 'Software Engineer',
    company: 'Giesecke+Devrient',
    description:
      'Full Stack development of multiple backend solutions with Java and JavaScript/TypeScript using Oracle SQL and MongoDB, and also involved in the design of a website using Angular.',
    link: 'https://www.gi-de.com/',
    technologies: [
      'Java',
      'SQL',
      'JavaScript',
      'TypeScript',
      'MongoDB',
      'Angular',
      'Git',
      'SCRUM',
      'API Rest',
      'Jira',
      'Confluence',
      'Bitbucket'
    ]
  },
  {
    startDate: 'February 2023',
    endDate: 'July 2023',
    title: 'Researcher',
    company: 'Universitat Politécnica de Catalunya',
    description:
      'Research on indoor light energy harvesting. Responsible for conducting multiple studies on photovoltaic cells under various types of light at different levels of light intensity.',
    link: 'https://doi.org/10.3390/proceedings2024097149',
    technologies: ['Matlab', 'KiCad', 'BenchVue', 'AvaSoft']
  }
]
---

<ol class="relative mt-8 md:mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li>
        <ExperienceItem {...experience} lang={lang} />
      </li>
    ))
  }
</ol>

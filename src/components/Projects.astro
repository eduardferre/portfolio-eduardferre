---
import SwiftIcon from '@/icons/SwiftIcon.astro'
import PythonIcon from '@/icons/PythonIcon.astro'
import SQLServerIcon from '@/icons/SQLServerIcon.astro'
import MongoDBIcon from '@/icons/MongoDBIcon.astro'
import ReactIcon from '@/icons/ReactIcon.astro'
import NextJSIcon from '@/icons/NextJSIcon.astro'
import TailwindIcon from '@/icons/TailwindIcon.astro'
import TypeScriptIcon from '@/icons/TypeScriptIcon.astro'
import PrismaIcon from '@/icons/PrismaIcon.astro'
import SupabaseIcon from '@/icons/SupabaseIcon.astro'
import ProjectItem from './ProjectItem.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

// Neutral mono chips — the icon carries the colour, matching the hub's cards.
const TAGS = {
  PYTHON: { name: 'Python', icon: PythonIcon },
  SQL_SERVER: { name: 'MS SQL', icon: SQLServerIcon },
  MongoDB: { name: 'MongoDB', icon: MongoDBIcon },
  SWIFT: { name: 'Swift', icon: SwiftIcon },
  NEXTJS: { name: 'Next.js', icon: NextJSIcon },
  REACT: { name: 'React 19', icon: ReactIcon },
  TAILWIND: { name: 'Tailwind CSS', icon: TailwindIcon },
  TYPESCRIPT: { name: 'TypeScript', icon: TypeScriptIcon },
  PRISMA: { name: 'Prisma', icon: PrismaIcon },
  SUPABASE: { name: 'Supabase', icon: SupabaseIcon }
}

// Reverse chronological: the live project comes first.
const PROJECTS = [
  {
    title: t('project.1.title'),
    description: t('project.1.description'),
    tag: 'FinTech',
    icon: '◎',
    live: true,
    link: {
      name: 'Live Site',
      href: 'https://zenithfi.eduardferre.dev'
    },
    github: [
      {
        name: 'Code',
        href: 'https://github.com/eduardferre/zenithfi-web'
      }
    ],
    image: '/ZenithFi/zenithfi-web.webp',
    tags: [
      TAGS.NEXTJS,
      TAGS.REACT,
      TAGS.TYPESCRIPT,
      TAGS.TAILWIND,
      TAGS.PRISMA,
      TAGS.SUPABASE
    ]
  },
  {
    title: t('project.0.title'),
    description: t('project.0.description'),
    tag: 'Mobile / ML',
    icon: '◈',
    link: {
      name: 'Thesis',
      href: 'https://upcommons.upc.edu/handle/2117/403591'
    },
    github: [
      {
        name: 'App',
        href: 'https://github.com/eduardferre/eGym-app'
      },
      {
        name: 'Server',
        href: 'https://github.com/eduardferre/eGym-server'
      },
      {
        name: 'ML',
        href: 'https://github.com/eduardferre/eGym-ML_Testing'
      }
    ],
    image: '/eGym/eGymImage.webp',
    tags: [TAGS.PYTHON, TAGS.SQL_SERVER, TAGS.MongoDB, TAGS.SWIFT]
  }
]
---

<!-- A <div>, not a <section>: the nav's scroll-spy observes every <section>
     and only the id-carrying wrappers should participate. -->
<div class="flex flex-col gap-y-6 md:gap-y-8">
  {PROJECTS.map((project) => <ProjectItem {...project} />)}
</div>

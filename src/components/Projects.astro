---
import SwiftIcon from '@/icons/SwiftIcon.astro'
import PythonIcon from '@/icons/PythonIcon.astro'
import SQLServerIcon from '@/icons/SQLServerIcon.astro'
import MongoDBIcon from '@/icons/MongoDBIcon.astro'
import SwiftUIIcon from '@/icons/SwiftUIIcon.astro'
import ReactIcon from '@/icons/ReactIcon.astro'
import NextJSIcon from '@/icons/NextJSIcon.astro'
import TailwindIcon from '@/icons/TailwindIcon.astro'
import TypeScriptIcon from '@/icons/TypeScriptIcon.astro'
import PrismaIcon from '@/icons/PrismaIcon.astro'
import ProjectItem from './ProjectItem.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

const TAGS = {
  PYTHON: {
    name: 'Python',
    class: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50',
    icon: PythonIcon
  },
  SQL_SERVER: {
    name: 'MS SQL',
    class: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300 border border-red-200 dark:border-red-800/50',
    icon: SQLServerIcon
  },
  MongoDB: {
    name: 'MongoDB',
    class: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 border border-green-200 dark:border-green-800/50',
    icon: MongoDBIcon
  },
  SWIFT: {
    name: 'Swift',
    class: 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300 border border-orange-200 dark:border-orange-800/50',
    icon: SwiftIcon
  },
  SWIFT_UI: {
    name: 'SwiftUI',
    class: 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300 border border-orange-200 dark:border-orange-800/50',
    icon: SwiftUIIcon
  },
  NEXTJS: {
    name: 'Next.js',
    class: 'bg-gray-200 text-gray-900 dark:bg-gray-800 dark:text-gray-100 border border-gray-300 dark:border-gray-700',
    icon: NextJSIcon
  },
  REACT: {
    name: 'React 19',
    class: 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900/30 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800/50',
    icon: ReactIcon
  },
  TAILWIND: {
    name: 'Tailwind CSS',
    class: 'bg-sky-100 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300 border border-sky-200 dark:border-sky-800/50',
    icon: TailwindIcon
  },
  TYPESCRIPT: {
    name: 'TypeScript',
    class: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-900/30 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/50',
    icon: TypeScriptIcon
  },
  PRISMA: {
    name: 'Prisma',
    class: 'bg-teal-100 text-teal-800 dark:bg-teal-900/30 dark:text-teal-300 border border-teal-200 dark:border-teal-800/50',
    icon: PrismaIcon
  }
}

const PROJECTS = [
  {
    title: t('project.0.title'),
    description: t('project.0.description'),
    link: {
      name: 'Thesis',
      href: 'https://upcommons.upc.edu/handle/2117/403591'
    },
    github: [
      {
        name: 'App',
        href: 'https://github.com/eduardferre/eGym-app'
      },
      {
        name: 'Server',
        href: 'https://github.com/eduardferre/eGym-server'
      },
      {
        name: 'ML',
        href: 'https://github.com/eduardferre/eGym-ML_Testing'
      }
    ],
    image: '/eGym/eGymImage.webp',
    tags: [TAGS.PYTHON, TAGS.SQL_SERVER, TAGS.MongoDB, TAGS.SWIFT]
  },
  {
    title: t('project.1.title'),
    description: t('project.1.description'),
    link: {
      name: 'Live Site',
      href: 'https://zenithfi.eduardferre.dev'
    },
    github: [
      {
        name: 'Code',
        href: 'https://github.com/eduardferre/zenithfi-web'
      }
    ],
    image: '/ZenithFi/zenithfi-web.webp',
    tags: [TAGS.NEXTJS, TAGS.REACT, TAGS.TAILWIND, TAGS.TYPESCRIPT, TAGS.PRISMA]
  }
]
---

<section class="flex flex-col gap-y-16">
  {PROJECTS.map((project) => <ProjectItem {...project} />)}
</section>

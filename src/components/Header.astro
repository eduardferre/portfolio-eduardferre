---
import ThemeToggle from './ThemeToggle.astro'
import type { Lang } from '@/i18n/ui'
import { languages } from '@/i18n/ui'
import { useTranslations, getLocalizedPathname } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

const navItems = [
  {
    title: t('nav.experience'),
    label: 'experience',
    url: lang === 'en' ? '/#experience' : '/es/#experience'
  },
  {
    title: t('nav.projects'),
    label: 'projects',
    url: lang === 'en' ? '/#projects' : '/es/#projects'
  },
  {
    title: t('nav.aboutMe'),
    label: 'about-me',
    url: lang === 'en' ? '/#about-me' : '/es/#about-me'
  },
  {
    title: t('nav.contact'),
    label: 'contact',
    url: 'mailto:eduardferresanchez@gmail.com'
  }
]

const switchLang: Lang = lang === 'en' ? 'es' : 'en'
const switchUrl = getLocalizedPathname(Astro.url.pathname, switchLang)
---

<header
  class="fixed top-0 z-10 flex justify-center items-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 font-medium rounded-full text-xs text-gray-600 dark:text-gray-100 justify-center items-center sm:text-sm"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-purple-900 dark:hover:text-purple-600 sm:px-4 md:px-6"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <a
      href={switchUrl}
      class="relative block px-2 py-2 transition hover:text-purple-900 dark:hover:text-purple-600 sm:px-3 text-xs sm:text-sm font-semibold"
      aria-label={`Switch to ${languages[switchLang]}`}
    >
      {switchLang.toUpperCase()}
    </a>
    <ThemeToggle lang={lang} />
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll('section')
    const navItems = document.querySelectorAll('header nav a')

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute('aria-label') == entry.target.id) {
              item.classList.add('text-purple-600')
            } else {
              item.classList.remove('text-purple-600')
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: '0px',
      threshold: 0.3
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === 'hidden') {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  @reference "../styles/global.css";

  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
    @apply dark:bg-gray-800/50 bg-white/50;
  }

  @keyframes nav-shadown {
    from {
      background-color: transparent;
    }
    to {
      box-shadow:
        0 10px 15px -3px rgb(0 0 0 / 0.1),
        0 4px 6px -4px rgb(0 0 0 / 0.1),
        0 0 0 1px rgb(255 255 255 / 0.1);
      backdrop-filter: blur(8px);
    }
  }
</style>

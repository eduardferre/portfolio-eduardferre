---
import ThemeToggle from './ThemeToggle.astro'
import type { Lang } from '@/i18n/ui'
import { languages } from '@/i18n/ui'
import { useTranslations, getLocalizedPathname } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

const navItems = [
  {
    title: t('nav.experience'),
    label: 'experience',
    url: lang === 'en' ? '/#experience' : '/es/#experience'
  },
  {
    title: t('nav.projects'),
    label: 'projects',
    url: lang === 'en' ? '/#projects' : '/es/#projects'
  },
  {
    title: t('nav.aboutMe'),
    label: 'about-me',
    url: lang === 'en' ? '/#about-me' : '/es/#about-me'
  },
  {
    title: t('nav.contact'),
    label: 'contact',
    url: 'mailto:eduardferresanchez@gmail.com'
  }
]

const switchLang: Lang = lang === 'en' ? 'es' : 'en'
const switchUrl = getLocalizedPathname(Astro.url.pathname, switchLang)
---

<header class="fixed top-0 z-20 mx-auto mt-3 flex w-full items-center justify-center px-4">
  <nav
    class="flex max-w-full flex-wrap items-center justify-center gap-x-1 rounded-full px-2 py-1
           font-mono text-[10px] font-bold tracking-wider text-muted sm:gap-x-2 sm:text-[11px]"
  >
    {
      navItems.map((link) => (
        <a
          class:list={[
            'relative block rounded-full px-2 py-1.5 transition-colors hover:text-accent sm:px-3',
            link.label === 'contact' && 'hidden sm:block'
          ]}
          aria-label={link.label}
          href={link.url}
        >
          {link.title.toLowerCase()}
        </a>
      ))
    }
    <span class="text-faint" aria-hidden="true">|</span>
    <a
      href={switchUrl}
      class="relative block rounded-full px-2 py-1.5 font-bold transition-colors hover:text-accent"
      aria-label={`Switch to ${languages[switchLang]}`}
    >
      {switchLang.toUpperCase()}
    </a>
    <ThemeToggle lang={lang} />
  </nav>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const sections = document.querySelectorAll('section')
    const navItems = document.querySelectorAll('header nav a')

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute('aria-label') == entry.target.id) {
              item.classList.add('text-accent')
            } else {
              item.classList.remove('text-accent')
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: '0px',
      threshold: 0.3
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    // Cleanup function
    document.onvisibilitychange = () => {
      if (document.visibilityState === 'hidden') {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })
</script>

<style>
  @reference "../styles/global.css";

  /* Scroll-driven: the pill materialises as the page scrolls away from the top. */
  nav {
    animation: nav-surface 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
    border: 1px solid transparent;
  }

  @keyframes nav-surface {
    from {
      background-color: transparent;
      border-color: transparent;
      backdrop-filter: blur(0px);
    }
    to {
      background-color: color-mix(in srgb, var(--bg-card) 70%, transparent);
      border-color: var(--border);
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }
  }
</style>

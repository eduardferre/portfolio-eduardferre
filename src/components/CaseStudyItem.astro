---
import TechBadge from './TechBadge.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  /** Two-digit index shown in the `CASE 01` chip. */
  index: number
  tag: string
  title: string
  context: string
  challenge: string
  /** Left-to-right architecture strip; the last item is the deliverable. */
  pipeline: string[]
  steps: { title: string; body: string }[]
  outcome: string
  stack: string[]
  lang?: Lang
}

const {
  index,
  tag,
  title,
  context,
  challenge,
  pipeline,
  steps,
  outcome,
  stack,
  lang = 'en'
} = Astro.props

const t = useTranslations(lang)
---

<article
  class="group relative overflow-hidden rounded-2xl border border-line bg-surface p-5
         shadow-[0_1px_2px_rgba(15,15,26,0.04)] transition-all duration-300
         hover:border-line-hover hover:shadow-[0_16px_40px_-20px_var(--accent-glow)] md:p-7"
>
  <div
    class="pointer-events-none absolute -right-28 -top-28 size-72 rounded-full bg-accent/10 opacity-0
           blur-3xl transition-opacity duration-500 group-hover:opacity-100"
    aria-hidden="true"
  >
  </div>

  <div class="relative">
    <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
      <span
        class="rounded border border-accent/30 bg-accent-soft px-2 py-0.5 font-mono text-[10px]
               font-bold tracking-[0.2em] uppercase text-accent"
      >
        {t('case.label')} {String(index).padStart(2, '0')}
      </span>
      <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-faint">{tag}</span>
    </div>

    <h3 class="font-display text-xl font-extrabold leading-tight text-fg md:text-2xl">
      {title}
    </h3>

    <div
      class="mt-4 text-pretty leading-relaxed text-muted [&_strong]:font-semibold [&_strong]:text-accent"
      set:html={context}
    />

    <!-- Architecture strip: horizontal on desktop, stacked on mobile -->
    <ol
      class="mt-6 flex flex-col gap-1.5 rounded-lg border border-line bg-canvas/40 p-3
             md:flex-row md:items-stretch md:gap-0"
      aria-label={t('case.approach')}
    >
      {
        pipeline.map((node, i) => (
          <>
            {i > 0 && (
              <li
                class="flex items-center justify-center font-mono text-xs text-accent md:px-1"
                aria-hidden="true"
              >
                <span class="md:hidden">↓</span>
                <span class="hidden md:inline">→</span>
              </li>
            )}
            <li
              class:list={[
                'flex flex-1 items-center justify-center rounded border px-2 py-2 text-center font-mono text-[10px] leading-tight md:text-[11px]',
                i === pipeline.length - 1
                  ? 'border-accent/40 bg-accent-soft font-bold text-accent'
                  : 'border-line bg-surface text-muted'
              ]}
            >
              {node}
            </li>
          </>
        ))
      }
    </ol>

    <!-- The problem -->
    <section class="mt-7 border-l-2 border-accent/40 pl-4">
      <h4 class="font-mono text-[10px] tracking-[0.2em] uppercase text-faint md:text-[11px]">
        {t('case.challenge')}
      </h4>
      <p
        class="mt-2 text-pretty leading-relaxed text-muted [&_strong]:font-semibold [&_strong]:text-accent"
        set:html={challenge}
      />
    </section>

    <!-- How it works -->
    <section class="mt-7">
      <h4 class="font-mono text-[10px] tracking-[0.2em] uppercase text-faint md:text-[11px]">
        {t('case.approach')}
      </h4>
      <ol class="mt-3 grid gap-4 md:grid-cols-2 md:gap-5">
        {
          steps.map((step, i) => (
            <li class="rounded-lg border border-line bg-canvas/40 p-4">
              <p class="flex items-baseline gap-2 font-display font-extrabold text-fg">
                <span class="font-mono text-[11px] text-accent" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {step.title}
              </p>
              <p
                class="mt-2 text-pretty text-sm leading-relaxed text-muted [&_strong]:font-semibold [&_strong]:text-accent"
                set:html={step.body}
              />
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Where it stands -->
    <section class="mt-7 rounded-lg border border-line bg-accent-soft p-4 md:p-5">
      <h4 class="font-mono text-[10px] tracking-[0.2em] uppercase text-faint md:text-[11px]">
        {t('case.outcome')}
      </h4>
      <p class="mt-2 text-pretty leading-relaxed text-muted">{outcome}</p>
    </section>

    <div class="mt-6 flex flex-wrap gap-1.5">
      {stack.map((tech) => <TechBadge>{tech}</TechBadge>)}
    </div>
  </div>
</article>

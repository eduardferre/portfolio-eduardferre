---
const { href, ...rest } = Astro.props
const isMail = typeof href === 'string' && href.startsWith('mailto:')
---

<a
  href={href}
  {...rest}
  target={isMail ? undefined : '_blank'}
  rel={isMail ? undefined : 'noopener noreferrer'}
  class="group inline-flex items-center gap-x-2 rounded-lg border border-line bg-surface px-3 py-2
         font-mono text-[11px] sm:text-xs text-muted
         transition-colors duration-200 hover:border-accent/60 hover:text-accent hover:bg-accent-soft"
>
  <slot />
</a>

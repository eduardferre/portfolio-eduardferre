---
const { ...rest } = Astro.props
---

<a
  target="_blank"
  rel="noopener noreferrer"
  {...rest}
  class="group inline-flex max-w-fit items-center justify-center gap-2 rounded-lg border border-line bg-surface px-3 py-2
         font-mono text-[11px] md:text-xs text-muted
         transition-colors duration-200 hover:border-accent/60 hover:bg-accent-soft hover:text-accent"
>
  <slot />
</a>

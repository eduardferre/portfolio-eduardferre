---
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)
---

<article
  class="flex flex-col justify-center items-center gap-8 md:flex-row
              text-gray-700 dark:text-gray-300"
>
  <div
    class="[&>p]:mb-4 [&>p>strong]:text-purple-900 dark:[&>p>strong]:text-purple-600 [&>p>strong]:font-normal [&>p>strong]:font-mono order-2 md:order-1"
  >
    <p set:html={t('about.p1')} />
    <p set:html={t('about.p2')} />
    <p set:html={t('about.p3')} />
    <p set:html={t('about.p4')} />
    <p set:html={t('about.p5')} />
  </div>
  <img
    loading="lazy"
    src="/aboutImage.webp"
    alt="Eduard Ferré about me photo"
    class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl bg-purple-800/30 dark:bg-purple-200 ring-1 ring-purple-800/60 dark:ring-white/20"
    style="object-position: 50% 50%;"
  />
</article>

---
import SunIcon from '@/icons/SunIcon.astro'
import MoonIcon from '@/icons/MoonIcon.astro'
import SystemIcon from '@/icons/SystemIcon.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props
const t = useTranslations(lang)

const THEMES = [
  { key: 'light', label: t('theme.light') },
  { key: 'dark', label: t('theme.dark') },
  { key: 'system', label: t('theme.system') }
]
---

<div class="relative ml-1 mr-1">
  <button
    id="theme-toggle-btn"
    class="appearance-none border-none flex text-muted hover:text-accent transition cursor-pointer"
  >
    <span class="sr-only">{t('theme.srOnly')}</span>
    <SunIcon id="light" class="theme-toggle-icon size-5 transition-all" />
    <MoonIcon
      id="dark"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
    <SystemIcon
      id="system"
      class="theme-toggle-icon absolute size-5 transition-all"
    />
  </button>
  <div
    id="themes-menu"
    class="absolute hidden scale-80 top-8 right-0 min-w-32 rounded-lg border border-line bg-surface/95 p-1
           font-mono text-[11px] text-muted shadow-[0_8px_24px_rgb(0,0,0,0.15)] backdrop-blur-md"
  >
    <ul>
      {
        THEMES.map((theme) => (
          <li
            class="themes-menu-option cursor-pointer rounded px-2 py-1.5 lowercase transition-colors hover:bg-accent-soft hover:text-accent"
            data-theme={theme.key}
          >
            {theme.label}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  #themes-menu.open {
    display: inline;
    animation: scale-up-center 0.15s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes scale-up-center {
    from {
      transform: scale(0.8);
      opacity: 0;
    }

    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  const matchMedia = window.matchMedia('(prefers-color-scheme: dark)')

  const getThemePreference = (): string => {
    if (typeof localStorage !== 'undefined') {
      return localStorage.getItem('theme') ?? 'system'
    }
    return matchMedia.matches ? 'dark' : 'light'
  }

  const updateIcon = (themePreference: string) => {
    document.querySelectorAll('.theme-toggle-icon').forEach((element) => {
      ;(element as HTMLElement).style.scale =
        element.id === themePreference ? '1' : '0'
    })
  }

  const updateTheme = () => {
    const themePreference = getThemePreference()
    const isDark =
      themePreference === 'dark' ||
      (themePreference === 'system' && matchMedia.matches)

    updateIcon(themePreference)
    document.documentElement.classList[isDark ? 'add' : 'remove']('dark')
  }

  // Apply theme immediately on every page load (including after navigation)
  document.addEventListener('astro:page-load', () => {
    updateTheme()

    const themesMenu = document.getElementById('themes-menu')
    if (!themesMenu) return

    document.addEventListener(
      'click',
      () => themesMenu.classList.remove('open'),
      { once: false }
    )

    document
      .getElementById('theme-toggle-btn')
      ?.addEventListener('click', (e) => {
        e.stopPropagation()
        const isClosed = !themesMenu.classList.contains('open')
        themesMenu.classList[isClosed ? 'add' : 'remove']('open')
      })

    document.querySelectorAll('.themes-menu-option').forEach((element) => {
      element.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        localStorage.setItem('theme', target.dataset.theme ?? 'system')
        updateTheme()
        themesMenu.classList.remove('open')
      })
    })
  })

  // Also react to system dark/light changes
  matchMedia.addEventListener('change', updateTheme)
</script>

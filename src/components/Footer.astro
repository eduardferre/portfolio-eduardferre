---
import type { Lang } from '@/i18n/ui'

interface Props {
  lang?: Lang
}

const { lang = 'en' } = Astro.props

const currentYear = new Date().getFullYear()
---

<footer class="mx-auto mb-10 mt-24 w-full max-w-4xl px-4">
  <div class="mb-6 h-px w-full bg-line"></div>
  <div
    class="flex flex-col items-center justify-between gap-y-3 font-mono text-[10px] tracking-widest text-faint md:flex-row"
  >
    <a
      href="https://eduardferre.dev/"
      target="_blank"
      rel="noopener noreferrer"
      class="transition-colors hover:text-accent">eduardferre.dev</a
    >
    <span>© {currentYear}</span>
  </div>
</footer>

---
import Layout from '@/layouts/Layout.astro'

import AboutMe from '@/components/AboutMe.astro'
// Case studies withheld for NDA reasons — the section and its copy live in
// CaseStudies.astro and i18n/ui.ts, ready to re-enable if that ever changes.
// import CaseStudies from '@/components/CaseStudies.astro'
import Experience from '@/components/Experience.astro'
import Projects from '@/components/Projects.astro'
import SectionContainer from '@/components/SectionContainer.astro'
import SectionHeader from '@/components/SectionHeader.astro'
import Hero from '@/components/Hero.astro'
import { useTranslations } from '@/i18n/utils'

const lang = 'en'
const t = useTranslations(lang)
---

<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
  <main class="px-4">
    <SectionContainer class="py-20 md:py-36">
      <Hero lang={lang} />
    </SectionContainer>

    <div class="space-y-20 md:space-y-28">
      <SectionContainer id="experience">
        <SectionHeader command="experience" title={t('section.experience')} />
        <Experience lang={lang} />
      </SectionContainer>

      <SectionContainer id="projects">
        <SectionHeader command="projects" title={t('section.projects')} />
        <Projects lang={lang} />
      </SectionContainer>

      <SectionContainer id="about-me">
        <SectionHeader command="about-me" title={t('section.aboutMe')} />
        <AboutMe lang={lang} />
      </SectionContainer>
    </div>
  </main>
</Layout>

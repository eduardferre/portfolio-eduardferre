---
import Layout from '@/layouts/Layout.astro'

import AboutMe from '@/components/AboutMe.astro'
import BriefcaseIcon from '../../icons/BriefcaseIcon.astro'
import CodeIcon from '../../icons/CodeIcon.astro'
import Experience from '../../components/Experience.astro'
import ProfileIcon from '@/icons/ProfileIcon.astro'
import Projects from '../../components/Projects.astro'
import SectionContainer from '../../components/SectionContainer.astro'
import Hero from '@/components/Hero.astro'
import { useTranslations } from '@/i18n/utils'

const lang = 'es'
const t = useTranslations(lang)
---

<Layout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero lang={lang}>
        <slot />
      </Hero>
    </SectionContainer>
    <div class="space-y-16 md:space-y-24">
      <SectionContainer id="experience">
        <h2
          class="text-2xl md:text-3xl text-black/80 dark:text-white font-semibold
              flex flex-row items-center gap-x-4 mb-6"
        >
          <BriefcaseIcon class="size-6 md:size-7" />{t('section.experience')}
        </h2>
        <Experience lang={lang} />
      </SectionContainer>
      <SectionContainer id="projects">
        <h2
          class="text-2xl md:text-3xl text-black/80 dark:text-white font-semibold
              flex flex-row items-center gap-x-4 mb-6"
        >
          <CodeIcon class="size-6 md:size-7" />{t('section.projects')}
        </h2>
        <Projects lang={lang} />
      </SectionContainer>

      <SectionContainer id="about-me">
        <h2
          class="text-2xl md:text-3xl text-black/80 dark:text-white font-semibold
              flex flex-row items-center gap-x-4 mb-6"
        >
          <ProfileIcon class="size-6 md:size-7" />{t('section.aboutMe')}
        </h2>

        <AboutMe lang={lang} />
      </SectionContainer>
    </div>
  </main>
</Layout>
